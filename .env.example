# Non-sensitive configuration only.
# Real secrets must be stored outside the repository and mounted as read-only files.

APP_ENV=development
APP_NAME=Personal Asset OS
LOG_LEVEL=INFO
TZ=Asia/Taipei

# Phase 1 must remain true. Phase 2 may change this only after its Phase Gate.
MOCK_MARKET_DATA=true

# These are paths, not secret values.
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
SESSION_SECRET_FILE=/run/secrets/session_secret

# P0-003 local Compose input names only. Supply values through an untracked .env;
# P0-005 replaces these with read-only secret files for deployment.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
