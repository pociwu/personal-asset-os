# Non-sensitive configuration only.
# Real secrets must be stored outside the repository and mounted as read-only files.

PAOS_APP_ENV=development
PAOS_APP_NAME=Personal Asset OS
PAOS_LOG_LEVEL=INFO
TZ=Asia/Taipei
PAOS_WEB_PORT=8080
PAOS_IMAGE_TAG=candidate

# Phase 1 must remain true. Phase 2 may change this only after its Phase Gate.
PAOS_MOCK_MARKET_DATA=true

# Host path only; the directory and its contents remain outside the repository.
PAOS_SECRET_DIR=/opt/ai-pm-os/secrets/personal-asset-os

# Backup paths and public age recipient only. Never put an age identity here.
PAOS_BACKUP_DIR=/var/backups/personal-asset-os
PAOS_AGE_RECIPIENT_FILE=/opt/ai-pm-os/secrets/personal-asset-os/backup_age_recipient
